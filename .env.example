# Copy to .env.local. Never commit real credentials.
APP_ORIGIN=http://localhost:3000

# Optional for public pages. Required for account capabilities.
MONGODB_URI=
MONGODB_DB_NAME= kalyanapura

# Generate with node crypto.randomBytes(32).toString('hex'). Keep both keys stable.
BETTER_AUTH_SECRET=
AUTH_EMAIL_ENCRYPTION_KEY=
RESEND_API_KEY=
# Local test sender is limited to your Resend account's own email address.
AUTH_EMAIL_FROM=onboarding@resend.dev

# Local Inngest server; do not set this to 1 in production.
INNGEST_DEV=1
# Required when using Inngest Cloud instead of the local server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional: only a header overwritten by your trusted deployment proxy.
# Without it, all clients share a conservative database rate-limit bucket.
AUTH_TRUSTED_IP_HEADER=
