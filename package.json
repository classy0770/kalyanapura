{
  "name": "kalyanapura",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:contracts": "node --conditions=react-server scripts/scaffold-contract-check.cjs",
    "check:accounts": "node --conditions=react-server scripts/accounts-integration-check.cjs",
    "check:weddings": "node --conditions=react-server scripts/weddings-integration-check.cjs",
    "check:weddings:browser": "node --conditions=react-server scripts/weddings-browser-check.cjs",
    "check:guests": "node --conditions=react-server scripts/guests-integration-check.cjs",
    "check:guests:import": "node --conditions=react-server scripts/guest-import-integration-check.cjs",
    "check:guests:import:browser": "node --conditions=react-server scripts/weddings-browser-check.cjs --imports-only",
    "check:invitations": "node --conditions=react-server scripts/invitations-integration-check.cjs",
    "check:rsvp": "node --conditions=react-server scripts/rsvp-integration-check.cjs",
    "check:rsvp:organiser": "node --conditions=react-server scripts/member-rsvp-integration-check.cjs",
    "check:rsvp:browser": "node --conditions=react-server scripts/weddings-browser-check.cjs --invitations-only",
    "check:invitations:browser": "node --conditions=react-server scripts/weddings-browser-check.cjs --invitations-only",
    "check:guests:browser": "node --conditions=react-server scripts/weddings-browser-check.cjs --guests",
    "check:events": "node --conditions=react-server scripts/events-integration-check.cjs",
    "check:events:browser": "node --conditions=react-server scripts/weddings-browser-check.cjs --events",
    "check:smoke": "node scripts/scaffold-smoke-check.cjs"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "inngest": "4.23.0",
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.0",
    "mongodb-memory-server": "11.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
